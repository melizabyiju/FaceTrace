# === FaceTrace Configuration ===

# SerpAPI key for Google Lens reverse image search
# Get a free key (100 searches/month): https://serpapi.com/
SERPAPI_KEY=

# (Optional) ImgBB API key for image hosting
# Get free key: https://api.imgbb.com/
IMGBB_API_KEY=

# Blockchain RPC URL (default: local Hardhat node)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545

# Private key for blockchain transactions
# Default: Hardhat account #0 (NEVER use on mainnet!)
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Deployed contract address (auto-set after first deploy)
CONTRACT_ADDRESS=

# Chain ID (31337 = Hardhat local, 11155111 = Sepolia)
CHAIN_ID=31337

# Face recognition model: VGG-Face, Facenet, Facenet512, ArcFace, OpenFace, DeepFace, SFace
FACE_MODEL=VGG-Face

# Face detector backend: opencv, ssd, mtcnn, retinaface, mediapipe
FACE_DETECTOR=opencv

# Similarity threshold for face matching (lower = stricter)
SIMILARITY_THRESHOLD=0.40

# Demo mode (set to true only for testing without live search)
DEMO_MODE=false
